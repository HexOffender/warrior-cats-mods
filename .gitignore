# Your mods, wcmods.json and backups are outside this folder (%LOCALAPPDATA%\WCMods; wcmods/userdata.py).
# Here is where older versions kept them, until the first start moves them out, and where WCMODS_DATA set
# to this folder keeps them.
backups/
wcmods.json
/mods/

# Generated from the installed game (game data, not ours to redistribute)
vanilla/
build/
agent-output/
colour_tables.json

# Tooling
__pycache__/
*.pyc
.claude/
cache/

# The C++ SDK's test mod: what a build and a test run leave in it
tests/cpp-sdk/dlls/
tests/cpp-sdk/results.json
tests/cpp-sdk/request.txt
tests/cpp-sdk/written.txt
tests/cpp-sdk/bom.txt
.pytest_cache/
